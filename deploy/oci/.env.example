# COPY to .env on the Oracle VM; never commit actual credentials.
# First configure DNS A record for your own API subdomain to point to the VM IPv4.
PUBLIC_HOSTNAME=api.example.com

# Use a URL-safe password (letters, digits, hyphens, underscores) or URL-encode it in POSTGRES_URL.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_URL=postgresql+psycopg2://unichat:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/university_ai
BACKEND_API_KEY=CHANGE_ME_LONG_RANDOM_API_KEY
ADMIN_API_KEY=CHANGE_ME_DIFFERENT_RANDOM_ADMIN_KEY

# UniChat currently requires OpenAI embeddings and AI calls.
# Chat Groq support can be activated separately; do not assume the entire RAG pipeline is free.
OPENAI_API_KEY=
